rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function crewPath(c) { return /databases/$(database)/documents/crews/$(c); }
    function inCrew(c) { return signedIn() && exists(/databases/$(database)/documents/crews/$(c)/members/$(request.auth.uid)); }
    function isAdmin(c) { return signedIn() && (get(crewPath(c)).data.ownerId == request.auth.uid || exists(/databases/$(database)/documents/crews/$(c)/founders/$(request.auth.uid))); }
    function onlyWitness() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['witnesses']) && request.resource.data.witnesses.hasAll(resource.data.witnesses) && request.resource.data.witnesses.removeAll(resource.data.witnesses).hasOnly([request.auth.uid]) && resource.data.uid != request.auth.uid; }
    match /users/{uid} {
      allow read, write: if isMe(uid);
      match /explored/{p} { allow read, write: if isMe(uid); }
      match /vehicles/{v} { allow read: if signedIn(); allow write: if isMe(uid); }
      match /media/{m} { allow read: if signedIn(); allow write: if isMe(uid); }
    }
    match /crews/{c} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /members/{uid} {
        allow read: if inCrew(c);
        allow create, update: if isMe(uid) && exists(crewPath(c)) && (get(crewPath(c)).data.ownerId == request.auth.uid || (!(exists(/databases/$(database)/documents/crews/$(c)/bans/$(uid)) && get(/databases/$(database)/documents/crews/$(c)/bans/$(uid)).data.get('blocked', true) == true) && !(request.resource.data.get('phoneKey', '-') in get(crewPath(c)).data.get('bannedPhones', []))));
        allow delete: if isMe(uid) || (signedIn() && get(crewPath(c)).data.ownerId == request.auth.uid);
      }
      match /bass/{id} {
        allow read: if inCrew(c);
        allow create: if inCrew(c) && request.resource.data.uid == request.auth.uid && request.resource.data.db is number && request.resource.data.witnesses.size() == 0;
        allow update: if inCrew(c) && onlyWitness();
        allow delete: if inCrew(c) && resource.data.uid == request.auth.uid;
      }
      match /speed/{id} {
        allow read: if inCrew(c);
        allow create: if inCrew(c) && request.resource.data.uid == request.auth.uid && request.resource.data.kmh is number && request.resource.data.witnesses.size() == 0;
        allow update: if inCrew(c) && onlyWitness();
        allow delete: if inCrew(c) && resource.data.uid == request.auth.uid;
      }
      match /meets/{id} {
        allow read: if inCrew(c);
        allow create: if inCrew(c) && request.resource.data.hostId == request.auth.uid && request.resource.data.when is number;
        allow update: if inCrew(c) && ((resource.data.hostId == request.auth.uid && request.resource.data.hostId == resource.data.hostId) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going']) && request.resource.data.going.removeAll(resource.data.going).hasOnly([request.auth.uid]) && resource.data.going.removeAll(request.resource.data.going).hasOnly([request.auth.uid])));
        allow delete: if inCrew(c) && resource.data.hostId == request.auth.uid;
      }
      match /launch/{id} {
        allow read: if inCrew(c);
        allow create: if inCrew(c) && request.resource.data.uid == request.auth.uid && request.resource.data.witnesses.size() == 0 && (request.resource.data.t60 is number || request.resource.data.t100 is number || request.resource.data.qm is number);
        allow update: if inCrew(c) && onlyWitness();
        allow delete: if inCrew(c) && resource.data.uid == request.auth.uid;
      }
      match /chat/{id} {
        allow read: if inCrew(c);
        allow create: if inCrew(c) && request.resource.data.uid == request.auth.uid && request.resource.data.at is number && request.resource.data.text is string && request.resource.data.text.size() <= 1000 && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 800000));
        allow delete: if inCrew(c) && resource.data.uid == request.auth.uid;
      }
      match /claims/{token} {
        allow read, create: if signedIn() && get(crewPath(c)).data.ownerId == request.auth.uid;
        allow delete: if (signedIn() && get(crewPath(c)).data.ownerId == request.auth.uid) || (inCrew(c) && getAfter(/databases/$(database)/documents/crews/$(c)/founders/$(request.auth.uid)).data.token == token);
      }
      match /founders/{uid} {
        allow read: if inCrew(c);
        allow create: if isMe(uid) && inCrew(c) && request.resource.data.token is string && exists(/databases/$(database)/documents/crews/$(c)/claims/$(request.resource.data.token)) && !existsAfter(/databases/$(database)/documents/crews/$(c)/claims/$(request.resource.data.token));
        allow delete: if signedIn() && get(crewPath(c)).data.ownerId == request.auth.uid;
      }
      match /merch/{id} {
        allow read: if inCrew(c);
        allow create, update, delete: if inCrew(c) && isAdmin(c);
      }
      match /orders/{id} {
        allow read: if inCrew(c) && (resource.data.uid == request.auth.uid || isAdmin(c));
        allow create: if inCrew(c) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'new' && request.resource.data.qty is int && request.resource.data.qty > 0 && request.resource.data.qty <= 20;
        allow update: if inCrew(c) && isAdmin(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt']);
        allow delete: if inCrew(c) && ((resource.data.uid == request.auth.uid && resource.data.status == 'new') || isAdmin(c));
      }
      match /meetkeys/{meetId} {
        allow get, create, update: if inCrew(c) && (get(/databases/$(database)/documents/crews/$(c)/meets/$(meetId)).data.hostId == request.auth.uid || isAdmin(c));
      }
      match /checkins/{id} {
        allow read: if inCrew(c);
        allow create, update: if inCrew(c) && request.resource.data.uid == request.auth.uid && id == request.resource.data.meet + '_' + request.auth.uid && request.resource.data.code == get(/databases/$(database)/documents/crews/$(c)/meetkeys/$(request.resource.data.meet)).data.code;
      }
      match /bans/{uid} {
        allow get: if isMe(uid) || (signedIn() && get(crewPath(c)).data.ownerId == request.auth.uid);
        allow list, create, update, delete: if signedIn() && get(crewPath(c)).data.ownerId == request.auth.uid;
        allow delete: if isMe(uid) && resource.data.get('blocked', true) == false;
      }
      match /push/{uid} {
        allow read: if inCrew(c);
        allow create, update: if isMe(uid) && inCrew(c) && request.resource.data.sub is string && request.resource.data.sub.size() < 4000;
        allow delete: if inCrew(c);
      }
      match /convoys/{id} {
        allow read: if inCrew(c);
        allow create: if inCrew(c) && request.resource.data.leaderId == request.auth.uid;
        allow update: if inCrew(c);
        allow delete: if inCrew(c) && resource.data.leaderId == request.auth.uid;
      }
    }
  }
}
